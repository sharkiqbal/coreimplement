rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public marketing content: anyone can read, only the signed-in admin can write.
    // There is exactly one real user in this project (the admin), created directly
    // via the Firebase console / Admin SDK - there is no public sign-up flow - so
    // "signed in at all" is an accurate stand-in for "is the admin."
    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /caseStudies/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Lead-generation forms: anyone can submit, but only the admin can read
    // the submissions back. Without this, anyone could list every visitor's
    // contact details and RFP submissions through the public Firestore API.
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /rfpSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
